; Engine configuration file.
; Open this folder in Godot 4.4+ (Project Manager > Import) to start editing.

config_version=5

[application]

config/name="Lookout"
config/description="Open-world anti-hero action game for Android."
run/main_scene="res://scenes/levels/test_city.tscn"
config/features=PackedStringArray("4.4", "Mobile")

[autoload]

InputSetup="*res://scripts/autoloads/input_setup.gd"
GameSettings="*res://scripts/autoloads/game_settings.gd"
WantedSystem="*res://scripts/autoloads/wanted_system.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_touch_from_mouse=false

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="enemies"
3d_physics/layer_4="police"
3d_physics/layer_5="civilians"
3d_physics/layer_6="vehicles"

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
